# Copy this file to `.env` and fill in your real values.
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/civictrack

# Used to sign/verify JWTs. Generate a real random value with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit your actual .env file or reuse this example value in production.
JWT_SECRET_KEY=insecure-dev-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
